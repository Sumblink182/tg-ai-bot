# =========================================================
# Telegram Bot 配置
# =========================================================
# 在 Telegram 中向 @BotFather 发送 /newbot 获取的 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =========================================================
# Antigravity 本地 Agent 配置
# =========================================================
# agy 命令路径 (默认通常为 /root/.local/bin/agy)
AGY_BIN_PATH=/root/.local/bin/agy

# 内置模型名称 (推荐默认：gemini-3.8-flash-high)
# 可选值包括：
# gemini-3.8-flash-high
# gemini-3.8-flash-medium
# gemini-3.7-flash-high
# claude-sonnet-4-6
MODEL_NAME=gemini-3.8-flash-high

# 运行模式：
# chat  - 纯对话模式（安全，仅问答思考，不执行服务器命令）
# agent - 全功能 Agent 模式（允许自动在服务器上执行终端命令与读写文件）
AGENT_MODE=chat

# =========================================================
# 安全与权限控制
# =========================================================
# 允许使用此 Bot 的 Telegram User ID 白名单（多个 ID 用逗号分隔，如 123456789,987654321）
# 强力建议填写你的个人 ID！留空则任何人只要搜索到你的 Bot 都能使用它。
ALLOWED_USER_IDS=

# 单次响应最大超时时间（秒）
TIMEOUT_SECONDS=300
