# =========================================================
# Telegram Bot 核心配置
# =========================================================
# 在 Telegram 中向 @BotFather 发送 /newbot 获取的 Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# =========================================================
# Antigravity 本地 Agent 引擎配置
# =========================================================
# agy 二进制命令路径 (默认通常为 /root/.local/bin/agy 或 /usr/local/bin/agy)
AGY_BIN_PATH=/root/.local/bin/agy

# 主引擎内置模型名称 (默认推荐：gemini-3.8-flash-high)
# 可选值包括：
# gemini-3.8-flash-high
# gemini-3.8-flash-medium
# gemini-3.7-flash-high
# claude-sonnet-4-6
MODEL_NAME=gemini-3.8-flash-high

# 默认初始运行模式：
# chat  - 纯对话安全模式（深度问答思考，严格隔离服务器系统命令）
# agent - 全功能 Agent 模式（允许全自主在服务器上执行终端命令与读写文件）
AGENT_MODE=chat

# =========================================================
# 安全与权限控制 (Default-Deny 零信任机制)
# =========================================================
# 允许使用此 Bot 的 Telegram User ID 白名单（多个 ID 用英文逗号分隔，如 123456789,987654321）
# ⚠️ 零信任安全设计：未配置白名单时，系统默认拒绝所有外部访问，防止服务器被陌生人提权接管！
ALLOWED_USER_IDS=

# 是否允许公开安全对话模式（false/true）
# 仅当 ALLOWED_USER_IDS 为空且此项设为 true 时，允许陌生人进行纯 chat 模式对话；
# 无论如何设置，高危的 agent 模式永远严格强制要求白名单非空并进行二次确认！
ALLOW_PUBLIC_CHAT=false

# 单次响应最大超时时间（秒）
TIMEOUT_SECONDS=300

# =========================================================
# 系统资源与并发控制
# =========================================================
# 全局最大并发执行任务数（防止并发拉起多个 agy 导致 VPS 内存或配额耗尽，建议 1G 内存 VPS 设为 2）
MAX_CONCURRENT_TASKS=2

# =========================================================
# 高可用备用 AI 引擎 (OpenAI 兼容协议，可选)
# =========================================================
# 当 agy 引擎不可用、凭证过期或超限时，自动无缝降级兜底回答（仅限 chat 模式）
ENABLE_FALLBACK=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
FALLBACK_MODEL=gpt-4o-mini
SYSTEM_PROMPT=你是一个部署在 Linux 服务器上的通用云端 AI 助手，请提供准确、高效、专业的回答。
MAX_HISTORY_ROUNDS=10

