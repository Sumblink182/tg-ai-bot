[Unit]
Description=Telegram AI Bot Service (Cloud Autonomous Agent)
After=network.target

[Service]
Type=simple
User=tgbot
Group=tgbot
WorkingDirectory=/opt/tg-ai-bot
ExecStart=/opt/tg-ai-bot/venv/bin/python3 -u /opt/tg-ai-bot/bot.py
Restart=always
RestartSec=5
# 限制子进程提权，提升系统安全性
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

